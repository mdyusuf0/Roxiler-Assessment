# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_rating
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ─────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ── Client ──────────────────────────────────────
CLIENT_URL=http://localhost:5173
